# ---- Free LLM providers (all optional; the pipeline falls back down the chain) ----
# Groq free tier  -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio free tier -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Local Ollama (free, offline). Leave blank to auto-pick the first installed model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# ---- Runtime ----
ATLAS_DB=data/atlas.db
# Override "today" (YYYY-MM-DD) for reproducible lifecycle logic / demos. Leave blank for real date.
ATLAS_AS_OF=
